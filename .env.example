# SMTP credentials used by app/api/bookings/route.ts to email the shop owner
# (atelierkharita@gmail.com) whenever a new booking comes in. Without these set,
# bookings still save locally — the app just skips sending the email and logs a warning.
#
# Since the owner's inbox is Gmail, the simplest option is sending through Gmail
# itself: enable 2-Step Verification on atelierkharita@gmail.com, then create an
# App Password at https://myaccount.google.com/apppasswords and use it below.
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=atelierkharita@gmail.com
#   EMAIL_SMTP_PASS=<16-character app password>
#   EMAIL_FROM=atelierkharita@gmail.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# Where new-booking emails are sent. Leave empty to use atelierkharita@gmail.com. Set it to your own address in local .env or Vercel Preview env to test without emailing the owner.
BOOKING_NOTIFY_EMAIL=

# Required for the /admin dashboard (sign-in, prices, images, orders).
# ADMIN_PASSWORD is the login password for the shop owner — pick something strong,
# this is the only thing standing between the public internet and your bookings/prices.
# ADMIN_SESSION_SECRET signs the login session cookie — any long random string,
# e.g. generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# The site's real production domain (no trailing slash), e.g. https://atelierkharita.nl
# Used to build the sitemap, robots.txt, canonical/hreflang tags, and Open Graph
# links. Without this set, those all fall back to http://localhost:3000, which
# is fine for local dev but wrong once deployed — set it in production.
NEXT_PUBLIC_SITE_URL=

# Pulls real reviews from the business's Google Business Profile for the
# testimonials section, instead of hand-typed placeholders.
#   1. In Google Cloud Console, create/select a project, enable the "Places API",
#      and enable billing (Google requires it even though this stays within the
#      free monthly quota for a single business's traffic).
#   2. Create an API key and restrict it to the Places API.
#   3. Find the business's Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# Without both of these set, the site falls back to the static testimonials
# in messages/*.json — nothing breaks, it just won't be live Google reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
